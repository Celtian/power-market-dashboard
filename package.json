{
  "name": "@power-market-dashboard/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "flags:generate": "flag-resizer",
    "i18n:extract": "transloco-keys-manager extract --sort --unflat --langs en cs --project web --output apps/web/public/i18n --default-value '███' --add-missing-keys --remove-extra-keys",
    "i18n:find": "transloco-keys-manager find --input apps/web/src --translations-path apps/web/public/i18n",
    "db:migrate": "bun run typeorm migration:run -d typeorm.config.ts",
    "db:rollback": "bun run typeorm migration:revert -d typeorm.config.ts",
    "import:history": "TS_NODE_PROJECT=tools/backend/tsconfig.cli.json node -r ts-node/register -r tsconfig-paths/register tools/backend/import-history.ts",
    "typeorm": "TS_NODE_PROJECT=tools/backend/tsconfig.cli.json node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "db:generate": "bun run typeorm migration:generate -d typeorm.config.ts",
    "db:status": "bun run typeorm migration:show -d typeorm.config.ts"
  },
  "private": true,
