{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@power-market-dashboard/market": ["./libs/market/src/index.ts"],
      "@power-market-dashboard/database": ["./libs/database/src/index.ts"],
      "@power-market-dashboard/database/testing": [
        "./libs/database/src/testing.ts"
      ],
      "@power-market-dashboard/ui": ["./libs/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
